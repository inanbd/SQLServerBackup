@{
    var site = SiteOptions.Value;
    var meta = ViewData.Meta();
    meta.Title = "SQL Server Backup Monitoring: Email, Slack & RPO Alerts";
    meta.AppendSiteName = false;
    meta.Description = "Monitor SQL Server backups: dashboard, history and reports, plus email, Slack, Teams and Discord webhook, Windows Event Log and missing-backup (RPO) alerts.";
    meta.OgType = "article";
    meta.Image = Screenshots.Get("reports").Src2x;
    meta.ImageAlt = Screenshots.Get("reports").Alt;
    meta.ImageWidth = 2290;
    meta.ImageHeight = 1418;
    meta.Breadcrumbs.Add(new("Home", "/"));
    meta.Breadcrumbs.Add(new("Docs", "/docs"));
    meta.Breadcrumbs.Add(new("Monitoring & alerts", "/docs/monitoring-and-alerts"));
    meta.StructuredData.Add(StructuredData.TechArticle(site, "Monitoring SQL Server backups and sending alerts", meta.Description, "/docs/monitoring-and-alerts"));
}

<section class="page-hero">
    <div class="container">
        <partial name="_Breadcrumbs" />
        <h1>Monitoring &amp; alerts</h1>
        <p class="lead">Know that every database was backed up &mdash; and hear about it within minutes when one wasn't. Dashboard, history and reports in the app; email, webhook and Event Log alerts outside it.</p>
    </div>
</section>

<div class="container docs">
    <partial name="_DocsNav" />
    <article class="prose">
        <nav class="toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>
                <li><a href="#dashboard">Dashboard</a></li>
                <li><a href="#history">History</a></li>
                <li><a href="#reports">Reports</a></li>
                <li><a href="#email">Email alerts</a></li>
                <li><a href="#webhook">Slack, Teams and Discord webhooks</a></li>
                <li><a href="#event-log">Windows Event Log</a></li>
                <li><a href="#rpo">Missing-backup (RPO) alerts</a></li>
            </ol>
