@page "/privacy"
@inject IOptions<SiteOptions> SiteOptions
@inject IOptions<GoogleAnalyticsOptions> Analytics
@{
    var site = SiteOptions.Value;
    var ga = Analytics.Value;
    var meta = ViewData.Meta();
    meta.Title = "Privacy Policy";
    meta.Description = "How the SQL Server Backup Suite website handles personal data: contact form messages, Google Analytics, cookies and server logs.";
    meta.Breadcrumbs.Add(new("Home", "/"));
    meta.Breadcrumbs.Add(new("Privacy", "/privacy"));
}

<section class="page-hero">
    <div class="container">
        <partial name="_Breadcrumbs" />
        <h1>Privacy policy</h1>
        <p class="lead">This page explains what this website collects, why, and what you can do about it. The SQL Server Backup Suite application itself sends no telemetry.</p>
    </div>
</section>

<section class="section">
    <div class="container prose">
        <h2 class="mt-0">Who is responsible</h2>
        <p>This website is operated by @site.Owner, the author of SQL Server Backup Suite. You can reach us through the <a href="/contact">contact form</a>.</p>

        <h2>Contact form</h2>
        <p>When you send a message we receive your name, email address, optional company name, topic and message, together with the time, your IP address and browser user agent (used to fight spam). The message is delivered to us by email and is not stored in a database on this website. We use it only to answer you and delete it when it is no longer needed. Repeated submissions from the same IP address are limited for a short time; this counter is kept in memory only.</p>

        <h2>Analytics and cookies</h2>
        @if (ga.Enabled)
        {
            <p>We use Google Analytics 4 to understand which pages are useful. Google Analytics uses cookies and processes data such as pages visited, approximate location derived from your IP address, device and browser. Google Analytics 4 does not log or store IP addresses.</p>
            @if (ga.RequireConsent)
            {
                <p>Analytics cookies are only set after you click <em>Accept analytics</em> in the cookie banner. Until then, Google's Consent Mode sends cookieless signals only. You can change your choice at any time with <button type="button" class="link-button" data-consent-open><u>Cookie settings</u></button>; your choice is stored in your browser's local storage.</p>
            }
            <p>Google processes this data as described in the <a href="https://policies.google.com/privacy" rel="noopener">Google Privacy Policy</a>. You can also opt out with the <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener">Google Analytics opt-out browser add-on</a>.</p>
        }
        else
        {
            <p>This website currently uses no analytics and sets no tracking cookies.</p>
        }
        <p>Opening the contact page sets a strictly necessary security cookie that protects the form against cross-site request forgery. It contains no personal data and is deleted when you close the browser. No other page sets cookies unless you accept analytics.</p>

        <h2>Server logs</h2>
        <p>Like most websites, the web server may log technical data such as the requested address, time, status code and IP address to keep the service secure and running. These logs are kept for a limited time.</p>

        <h2>Your rights</h2>
        <p>Depending on where you live, you may have the right to access, correct or delete your personal data, to object to or restrict its processing, and to lodge a complaint with a supervisory authority. To exercise these rights, <a href="/contact">contact us</a>.</p>

        @* Update this date whenever the policy text changes. *@
        <p class="muted">Last updated: October 18, 2026.</p>
    </div>
</section>
