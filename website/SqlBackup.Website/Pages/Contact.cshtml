@page "/contact"
@model ContactModel
@inject IOptions<SiteOptions> SiteOptions
@{
    var site = SiteOptions.Value;
    var meta = ViewData.Meta();
    meta.Title = "Contact";
    meta.Description = "Questions about SQL Server Backup Suite, help with setup, a bug or a feature idea? Send us a message and we will get back to you by email.";
    meta.Breadcrumbs.Add(new("Home", "/"));
    meta.Breadcrumbs.Add(new("Contact", "/contact"));
}

<section class="page-hero">
    <div class="container">
        <partial name="_Breadcrumbs" />
        <h1>Contact us</h1>
        <p class="lead">Questions, setup help, bug reports or feature ideas &mdash; send a message and we'll reply by email.</p>
    </div>
</section>

<section class="section">
    <div class="container contact-grid">
        <div>
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert--error" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" class="form" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="form__row">
                    <div class="field">
                        <label asp-for="Input.Name">Name</label>
                        <input asp-for="Input.Name" autocomplete="name" required maxlength="100">
                        <span asp-validation-for="Input.Name" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" type="email" autocomplete="email" required maxlength="254">
                        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form__row">
                    <div class="field">
                        <label asp-for="Input.Company">Company <span class="optional">(optional)</span></label>
                        <input asp-for="Input.Company" autocomplete="organization" maxlength="150">
                        <span asp-validation-for="Input.Company" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Topic">Topic</label>
                        <select asp-for="Input.Topic" required>
                            <option value="">Choose a topic&hellip;</option>
                            @foreach (var topic in ContactModel.Topics)
                            {
                                <option value="@topic">@topic</option>
                            }
                        </select>
                        <span asp-validation-for="Input.Topic" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Input.Message">Message</label>
                    <textarea asp-for="Input.Message" required minlength="20" maxlength="5000" rows="8"
                              placeholder="What can we help with? For problems, include the SQL Server version and the error shown in History."></textarea>
                    <span asp-validation-for="Input.Message" class="field-validation-error"></span>
                </div>

                <div class="hp-field" aria-hidden="true">
                    <label for="Website">Leave this field empty</label>
                    <input asp-for="Website" tabindex="-1" autocomplete="off">
                </div>
                <input asp-for="FormToken" type="hidden">

                <p class="form__hint">We use your details only to answer your message. See the <a href="/privacy">privacy policy</a>.</p>
                <div><button type="submit" class="btn btn--large">Send message</button></div>
            </form>
        </div>

        <aside>
            <div class="card">
                <h2 class="mt-0">Other ways to get help</h2>
                <ul class="checklist">
                    <li>Read the <a href="/docs">getting started guide</a> and <a href="/docs/troubleshooting">troubleshooting</a></li>
                    <li>Browse the <a href="/faq">frequently asked questions</a></li>
                    <li>Report bugs and request features on <a href="@site.IssuesUrl" rel="noopener">GitHub Issues</a></li>
                </ul>
                <p class="muted">When reporting a problem, the message from <em>History</em> and the matching lines from <code>C:\ProgramData\SqlBackup\logs</code> help most.</p>
            </div>
        </aside>
    </div>
</section>
