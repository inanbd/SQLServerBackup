@inject IOptions<SiteOptions> SiteOptions
<section class="cta">
    <div class="container cta__inner">
        <div>
            <h2>Start backing up SQL Server in five minutes</h2>
            <p>Free and open source under the MIT License. One installer sets up the backup service and the control panel.</p>
        </div>
        <div class="cta__actions">
            <a class="btn btn--large" href="/download" data-ga-event="download_cta">Download for Windows</a>
            <a class="btn btn--large btn--ghost-light" href="/docs">Read the guide</a>
        </div>
    </div>
</section>
