<Window x:Class="SqlBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Server Backup — Control Panel"
        Height="740" Width="1150"
        MinHeight="560" MinWidth="900"
        Closing="OnClosing">
  <DockPanel>
    <Border DockPanel.Dock="Left" Width="190" Background="#FF243447">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="SQL Server&#10;Backup" Foreground="White"
                   FontSize="19" FontWeight="Bold" Margin="16,20,16,24" LineHeight="24" />
        <ListBox ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="#FFD5DDE5" />
              <Setter Property="Padding" Value="16,10" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#FF3A4F68" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#FF2E4157" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" FontSize="14" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding SelectedSection.ViewModel}" Margin="20,16" />
  </DockPanel>
</Window>
