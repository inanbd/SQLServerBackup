<Window x:Class="SqlBackup.App.Views.OffsiteDestinationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Off-site destination"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
      <TextBox Grid.Column="1" Margin="0,6,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="1" Text="Kind" Style="{StaticResource FieldLabel}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0"
                ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />

      <TextBlock Grid.Row="2" Text="Key prefix" Style="{StaticResource FieldLabel}" />
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
        <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Optional folder/prefix for all uploads, e.g. sqlbackups/server01" Foreground="Gray" FontSize="11" />
      </StackPanel>
    </Grid>

    <GroupBox Header="Azure Blob Storage" Padding="10" Margin="0,10,0,0"
              Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=AzureBlob}">
      <StackPanel>
        <TextBlock Text="Container URL" />
        <TextBox Margin="0,4,0,0" Text="{Binding AzureContainerUrl, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="https://youraccount.blob.core.windows.net/container — the SAS token below needs create, write, list and delete rights."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="S3 / S3-compatible" Padding="10" Margin="0,10,0,0"
              Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=S3}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Bucket" VerticalAlignment="Center" />
          <TextBox Width="160" Margin="8,0" Text="{Binding S3Bucket, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Region" VerticalAlignment="Center" />
          <TextBox Width="110" Margin="8,0" Text="{Binding S3Region, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Custom endpoint" VerticalAlignment="Center" />
          <TextBox Width="240" Margin="8,0" Text="{Binding S3ServiceUrl, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox Content="Path-style" IsChecked="{Binding S3ForcePathStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Access key id" VerticalAlignment="Center" />
          <TextBox Width="240" Margin="8,0" Text="{Binding S3AccessKeyId, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Text="Custom endpoint is for MinIO/Backblaze/etc.; leave it empty for AWS." Foreground="Gray" FontSize="11" Margin="0,4,0,0" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Windows file share (SMB)" Padding="10" Margin="0,10,0,0"
              Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=SmbShare}">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseShare" Padding="10,4" Margin="8,0,0,0" />
          <TextBox Text="{Binding SmbPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Text="\\server\share\folder — a local or mapped path also works."
                   Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="User" VerticalAlignment="Center" />
          <TextBox Width="220" Margin="8,0" Text="{Binding SmbUsername, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="DOMAIN\user — leave empty to use the backup engine's own account"
                     Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="SFTP" Padding="10" Margin="0,10,0,0"
              Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Sftp}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Host" VerticalAlignment="Center" />
          <TextBox Width="220" Margin="8,0" Text="{Binding SftpHost, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Port" VerticalAlignment="Center" />
          <TextBox Width="60" Margin="8,0" Text="{Binding SftpPortText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Username" VerticalAlignment="Center" />
          <TextBox Width="180" Margin="8,0" Text="{Binding SftpUsername, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Remote path" VerticalAlignment="Center" />
          <TextBox Width="160" Margin="8,0" Text="{Binding SftpRemotePath, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding SecretLabel}" Style="{StaticResource FieldLabel}" />
      <StackPanel Grid.Column="1" Margin="0,6,0,0">
        <PasswordBox x:Name="SecretInput" PasswordChanged="OnSecretChanged" />
        <TextBlock Text="{Binding SecretHint}" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
      </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Test destination" Command="{Binding TestCommand}" Padding="12,5" />
    </StackPanel>
    <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Save" Click="OnSave" Padding="16,6" Margin="0,0,8,0" IsDefault="True" />
      <Button Content="Cancel" IsCancel="True" Padding="16,6" />
    </StackPanel>
  </StackPanel>
</Window>
