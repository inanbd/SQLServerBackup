<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for the NotifyIcon tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explicit usings everywhere: WPF + WinForms implicit usings would collide
         (Application, MessageBox, ...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SqlBackup.App</RootNamespace>
    <AssemblyName>SqlBackup.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlBackup.Core\SqlBackup.Core.csproj" />
  </ItemGroup>

</Project>
